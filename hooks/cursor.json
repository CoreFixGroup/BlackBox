{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/cursor-hook.js\" --plugin", "timeout": 15 }],
    "beforeSubmitPrompt": [{ "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/cursor-hook.js\" --plugin", "timeout": 15 }],
    "afterAgentResponse": [{ "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/cursor-hook.js\" --plugin", "timeout": 15 }],
    "afterAgentThought": [{ "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/cursor-hook.js\" --plugin", "timeout": 15 }],
    "beforeReadFile": [{ "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/cursor-hook.js\" --plugin", "timeout": 15 }],
    "preToolUse": [{ "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/cursor-hook.js\" --plugin", "timeout": 15 }],
    "postToolUse": [{ "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/cursor-hook.js\" --plugin", "timeout": 15 }],
    "postToolUseFailure": [{ "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/cursor-hook.js\" --plugin", "timeout": 15 }],
    "afterFileEdit": [{ "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/cursor-hook.js\" --plugin", "timeout": 15 }],
    "afterShellExecution": [{ "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/cursor-hook.js\" --plugin", "timeout": 15 }],
    "afterMCPExecution": [{ "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/cursor-hook.js\" --plugin", "timeout": 15 }],
    "subagentStart": [{ "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/cursor-hook.js\" --plugin", "timeout": 15 }],
    "subagentStop": [{ "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/cursor-hook.js\" --plugin", "timeout": 15 }],
    "preCompact": [{ "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/cursor-hook.js\" --plugin", "timeout": 15 }],
    "stop": [{ "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/cursor-hook.js\" --plugin", "timeout": 15 }],
    "sessionEnd": [{ "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/cursor-hook.js\" --plugin", "timeout": 15 }]
  }
